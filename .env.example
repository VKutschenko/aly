# ============================================
# NOSSO ESPAÇO — Variáveis de Ambiente
# ============================================

# --- Clerk (Autenticação) ---
# 1. Crie conta em https://dashboard.clerk.com
# 2. Crie um app → escolha "Next.js"
# 3. Copie as chaves abaixo
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Banco de Dados PostgreSQL (Neon) ---
# 1. Crie conta em https://neon.tech
# 2. New Project → PostgreSQL
# 3. Copie a Connection String
DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# --- Upload de Arquivos (UploadThing) ---
# 1. Crie conta em https://uploadthing.com
# 2. Create App → Next.js
# 3. Copie o Token
UPLOADTHING_TOKEN="..."

# --- Vídeo/Áudio (LiveKit Cloud) ---
# 1. Crie conta em https://cloud.livekit.io
# 2. Create Project
# 3. Em Settings → Keys: copie API Key e Secret
# 4. Em Settings → Project: copie a URL WebSocket
LIVEKIT_API_KEY="..."
LIVEKIT_API_SECRET="..."
NEXT_PUBLIC_LIVEKIT_URL="wss://seu-projeto.livekit.clo
